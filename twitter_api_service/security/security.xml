<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Twitter API Service Groups -->
        <record id="group_twitter_user" model="res.groups">
            <field name="name">Twitter User</field>
            <field name="category_id" ref="base.module_category_tools"/>
            <field name="comment">Can use Twitter API services</field>
        </record>

        <record id="group_twitter_manager" model="res.groups">
            <field name="name">Twitter Manager</field>
            <field name="category_id" ref="base.module_category_tools"/>
            <field name="implied_ids" eval="[(4, ref('group_twitter_user'))]"/>
            <field name="comment">Can manage Twitter API services and accounts</field>
        </record>

        <!-- Record Rules -->
        <record id="twitter_account_rule_user" model="ir.rule">
            <field name="name">Twitter Account: User Access</field>
            <field name="model_id" ref="model_twitter_account"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_twitter_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="twitter_account_rule_manager" model="ir.rule">
            <field name="name">Twitter Account: Manager Access</field>
            <field name="model_id" ref="model_twitter_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_twitter_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="twitter_service_rule_user" model="ir.rule">
            <field name="name">Twitter Service: User Access</field>
            <field name="model_id" ref="model_twitter_service"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_twitter_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="twitter_service_rule_manager" model="ir.rule">
            <field name="name">Twitter Service: Manager Access</field>
            <field name="model_id" ref="model_twitter_service"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_twitter_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="twitter_api_response_rule_user" model="ir.rule">
            <field name="name">Twitter API Response: User Access</field>
            <field name="model_id" ref="model_twitter_api_response"/>
            <field name="domain_force">[('service_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_twitter_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="twitter_api_response_rule_manager" model="ir.rule">
            <field name="name">Twitter API Response: Manager Access</field>
            <field name="model_id" ref="model_twitter_api_response"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_twitter_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>